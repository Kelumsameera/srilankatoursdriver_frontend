# Public URL of the Express API (exposed to the browser). Required in production.
# NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_API_BASE are accepted as aliases, but set only one.
# Falls back to http://localhost:5000/api when unset (development only).
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Browsers call the API through this site's own /api path, which Next.js forwards to NEXT_PUBLIC_API_URL,
# so the API's session cookies are first-party (required when the API is on another site, e.g.
# *.vercel.app + *.onrender.com). Set to "false" only if the API shares this site's domain
# (www.example.com + api.example.com); the browser then calls NEXT_PUBLIC_API_URL directly.
NEXT_PUBLIC_API_PROXY=true
# Server-only shared secret (must equal API_PROXY_SECRET in backend/.env, at least 32 characters). Proxied API
# calls carry the visitor's IP with it, so the API's per-IP rate limits keep working behind the proxy.
# Only set it where the host overwrites x-real-ip / x-forwarded-for with the real visitor IP (Vercel does);
# never prefix it with NEXT_PUBLIC_.
API_PROXY_SECRET=
# Canonical public URL of the website (used for SEO: canonical, hreflang, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.srilankatoursdriver.com

# Optional: private URL the Next.js server uses to reach the API (e.g. inside Docker/VPC)
API_URL_INTERNAL=

# Optional: "Sign in with Google" for customer accounts. OAuth 2.0 Web client ID from
# Google Cloud console → Credentials; must equal GOOGLE_CLIENT_ID in backend/.env. Empty hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shared secret – must equal REVALIDATE_SECRET in backend/.env. At least 32 characters
# (shorter values are rejected and revalidation stays off).
# Lets the API refresh cached public pages instantly after admin edits.
REVALIDATE_SECRET=

# E2E tests (npm run test:e2e)
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:5000/api
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
